package com.megathon.incident.asr

import android.annotation.SuppressLint
import android.media.AudioFormat
import android.media.AudioRecord
import android.media.MediaRecorder
import com.megathon.incident.speech.MicGate
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.currentCoroutineContext
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.flow
import kotlinx.coroutines.flow.flowOn
import kotlinx.coroutines.isActive

/**
 * Microphone as a cold flow of 20 ms PCM16 chunks (16 kHz mono). The mic opens when the flow is collected and
 * closes when it is cancelled. It is also the [MicGate] for the hands-free loop: while muted the chunks are read
 * and thrown away, so the app never hears its own voice and no stale audio builds up inside [AudioRecord].
 *
 * Needs the RECORD_AUDIO permission, which the UI must have been granted before collecting.
 * Use [MediaRecorder.AudioSource.VOICE_RECOGNITION] for tap-to-talk and
 * [MediaRecorder.AudioSource.VOICE_COMMUNICATION] (echo cancellation) for the hands-free loop.
 */
class AudioRecorder(
    private val source: Int = MediaRecorder.AudioSource.VOICE_RECOGNITION,
    private val sampleRate: Int = SAMPLE_RATE,
) : MicGate {
    @Volatile
    private var muted = false

    override fun mute() {
        muted = true
    }

    override fun unmute() {
        muted = false
    }

    @SuppressLint("MissingPermission")
    fun chunks(): Flow<ShortArray> = flow {
        val chunkSamples = sampleRate / 50
        val minBytes = AudioRecord.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
        check(minBytes > 0) { "AudioRecord.getMinBufferSize failed: $minBytes" }
        val record = AudioRecord(
            source,
            sampleRate,
            AudioFormat.CHANNEL_IN_MONO,
            AudioFormat.ENCODING_PCM_16BIT,
            maxOf(minBytes, chunkSamples * 2 * 8),
        )
        check(record.state == AudioRecord.STATE_INITIALIZED) { "AudioRecord did not initialise (is RECORD_AUDIO granted?)" }
        record.startRecording()
        try {
            val buffer = ShortArray(chunkSamples)
            while (currentCoroutineContext().isActive) {
                val read = record.read(buffer, 0, buffer.size)
                check(read >= 0) { "AudioRecord.read failed: $read" }
                if (read > 0 && !muted) emit(buffer.copyOf(read))
            }
        } finally {
            record.stop()
            record.release()
        }
    }.flowOn(Dispatchers.IO)

    companion object {
        const val SAMPLE_RATE = 16_000
    }
}
