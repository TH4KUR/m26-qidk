package com.megathon.incident.tts

import android.content.Context
import android.speech.tts.TextToSpeech
import android.speech.tts.UtteranceProgressListener
import com.megathon.incident.testing.Speaker
import kotlinx.coroutines.CompletableDeferred
import kotlinx.coroutines.suspendCancellableCoroutine
import java.util.Locale
import java.util.UUID
import java.util.concurrent.ConcurrentHashMap
import kotlin.coroutines.resume
import kotlin.coroutines.resumeWithException

/**
 * Speaks through Android's `TextToSpeech` with an offline voice (`isNetworkConnectionRequired == false`).
 * This runs on the CPU (it is not an NPU model); the UI says so. `speak` returns when the utterance is done,
 * which is when the hands-free loop may unmute the mic. Install the `en-IN`, `hi-IN` and `te-IN` voice packs
 * with network on before the event, then test in airplane mode.
 */
class AndroidTtsSpeaker(
    context: Context,
    private val locale: Locale = Locale("en", "IN"),
) : Speaker {
    private val initialised = CompletableDeferred<Boolean>()
    private val pending = ConcurrentHashMap<String, (Throwable?) -> Unit>()
    private val engine: TextToSpeech

    /** False when no offline voice matched: the UI shows a warning, and in airplane mode speech may fail. */
    @Volatile
    var isOffline: Boolean = false
        private set

    init {
        engine = TextToSpeech(context.applicationContext) { status ->
            if (status == TextToSpeech.SUCCESS) selectOfflineVoice()
            initialised.complete(status == TextToSpeech.SUCCESS)
        }
        engine.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
            override fun onStart(utteranceId: String?) = Unit
            override fun onDone(utteranceId: String?) {
                pending.remove(utteranceId)?.invoke(null)
            }

            @Deprecated("Deprecated in Java")
            override fun onError(utteranceId: String?) {
                pending.remove(utteranceId)?.invoke(IllegalStateException("TextToSpeech error"))
            }

            override fun onError(utteranceId: String?, errorCode: Int) {
                pending.remove(utteranceId)?.invoke(IllegalStateException("TextToSpeech error $errorCode"))
            }
        })
    }

    override suspend fun speak(text: String) {
        check(initialised.await()) { "TextToSpeech failed to initialise" }
        if (text.isBlank()) return
        suspendCancellableCoroutine { continuation ->
            val id = UUID.randomUUID().toString()
            pending[id] = { error -> if (error == null) continuation.resume(Unit) else continuation.resumeWithException(error) }
            continuation.invokeOnCancellation {
                pending.remove(id)
                engine.stop()
            }
            if (engine.speak(text, TextToSpeech.QUEUE_ADD, null, id) == TextToSpeech.ERROR) {
                pending.remove(id)
                continuation.resumeWithException(IllegalStateException("TextToSpeech.speak failed"))
            }
        }
    }

    fun shutdown() {
        engine.stop()
        engine.shutdown()
    }

    private fun selectOfflineVoice() {
        val offline = engine.voices.orEmpty().filter { !it.isNetworkConnectionRequired }
        val voice = offline.firstOrNull { it.locale == locale }
            ?: offline.firstOrNull { it.locale.language == locale.language }
            ?: offline.firstOrNull { it.locale == Locale.US }
        isOffline = voice != null
        if (voice != null) engine.voice = voice else engine.language = locale
    }
}
