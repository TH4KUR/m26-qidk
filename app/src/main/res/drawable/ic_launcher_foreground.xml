<?xml version="1.0" encoding="utf-8"?>
<!-- A speech bubble holding report lines: what was said becomes the report. The amber band is the evidence highlight.
     Everything sits inside the 66 dp safe zone of the 108 dp adaptive icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- bubble and tail -->
    <path
        android:fillColor="@color/brand_bubble"
        android:pathData="M40,30 L68,30 A12,12 0 0 1 80,42 L80,58 A12,12 0 0 1 68,70 L48,70 L34,80 L36,70 L40,70 A12,12 0 0 1 28,58 L28,42 A12,12 0 0 1 40,30 Z" />
    <!-- evidence highlight behind the second line -->
    <path
        android:fillColor="@color/brand_highlight"
        android:pathData="M35,47 L65,47 A2,2 0 0 1 67,49 L67,54 A2,2 0 0 1 65,56 L35,56 A2,2 0 0 1 33,54 L33,49 A2,2 0 0 1 35,47 Z" />
    <!-- report lines -->
    <path
        android:strokeColor="@color/brand_tile"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M37,42 L71,42 M37,51.5 L63,51.5 M37,61 L53,61" />
</vector>
